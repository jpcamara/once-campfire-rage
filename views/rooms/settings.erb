<section class="panel txt-align-center" style="view-transition-name: <%= editing ? "edit-room-#{room.id}" : "new-room" %>">
  <form action="<%= editing ? "/rooms/#{form_type}s/#{room.id}" : "/rooms/#{form_type}s" %>" accept-charset="UTF-8" method="post"><% if editing %><input type="hidden" name="_method" value="patch" /><% end %>
  <div class="flex align-center gap">
<% if can_administer %>
      <%== translation_button(:room_name) %>

      <label class="flex-item-grow txt-large">
        <input name="room[name]" id="room_name" class="input full-width" required="required" autofocus="autofocus" placeholder="Name the room" data-turbo-permanent="true" data-action="keydown.enter-&gt;form#submit:prevent" type="text" value="<%= room_name %>" />
        <span class="for-screen-reader">Name this room</span>
      </label>
<% else %>
      <h1 class="flex-item-grow txt-x-large">
        <%= room_name %>
      </h1>
<% end %>
  </div>

  <hr class="margin-block borderless">

  <section class="room-access margin-block pad-inline fill-shade border-radius">
  <menu class="flex flex-column gap margin-none pad overflow-y constrain-height" data-controller="filter" data-filter-active-class="filter--active" data-filter-selected-class="selected">
<% if form_type == "open" || can_administer %>
      <li class="flex align-center gap margin-none">
        <figure class="avatar flex-item-no-shrink" style="--avatar-border-radius: 0; --avatar-size: 4ch;">
          <img aria-hidden="true" class="colorize--black" style="background-color: transparent" src="<%= asset_path "everyone.svg" %>" />
          <span class="for-screen-reader">Everyone</span>
        </figure>

        <div class="min-width">
          <div class="overflow-ellipsis fill-shade"><strong>Everyone</strong></div>
        </div>

        <hr class="separator" aria-hidden="true">
<% if can_administer %>
        <a class="btn--faux flex-inline" tabindex="-1" data-turbo-action="replace" href="<%= type_change_path %>">
          <label for="room_type" class="switch">
<% if form_type == "open" %>
            <input type="checkbox" id="room_type" class="switch__input" checked="checked">
            <span class="switch__btn round"></span>
            <span class="for-screen-reader">Give only some access to this room</span>
<% else %>
            <input type="checkbox" id="room_type" class="switch__input">
            <span class="switch__btn round"></span>
            <span class="for-screen-reader">Give everyone access to this room</span>
<% end %>
          </label>
</a>
<% end %>
      </li>

      <hr class="separator full-width" style="--border-style: solid">
<% end %>
<% if user_count > 20 %>
    <input type="search" id="search" autocorrect="off" autocomplete="off" data-1p-ignore="true" class="input input--transparent full-width" placeholder="Filter…" data-action="input-&gt;filter#filter" />
<% end %>
    <div data-filter-target="list" contents>
<% selected_users.each do |member| %>
      <%== render_room_user(member, true) %>
<% end %>
<% if selected_users.any? && unselected_users.any? %>
        <hr class="separator full-width" style="--border-style: solid">
<% end %>
<% unselected_users.each do |member| %>
      <%== render_room_user(member, false) %>
<% end %>
    </div>
  </menu>
  </section>
<% if can_administer %>
  <button name="button" type="submit" class="btn btn--reversed txt-large center"><img aria-hidden="true" src="<%= asset_path "check.svg" %>" width="20" height="20" /><span class="for-screen-reader">Save</span></button>
<% end %>
</form>
</section>
<% if editing && can_administer %>
  <section class="panel txt-align-center">
    <form class="button_to" method="post" action="<%= base_url %>/rooms/<%= room.id %>"><input type="hidden" name="_method" value="delete" /><button class="btn btn--negative max-width" aria-label="Delete <%= room.name %>" data-turbo-confirm="Are you sure you want to delete this room and all messages in it? This can’t be undone." type="submit"><img aria-hidden="true" src="<%= asset_path "trash.svg" %>" width="20" height="20" /><span class="overflow-ellipsis"><%= room.name %></span></button></form>
  </section>
<% end %>
