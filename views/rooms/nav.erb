<% if account_logo_attached? %>
  <%== account_logo_tag %>
<% end %>
  <span class="btn btn--reversed btn--faux room--current">
    <h1 class="room__contents txt-medium overflow-ellipsis">
<% if room.direct? %>
        <span class="for-screen-reader">Ping with</span>
<% end %>
      <%= room_display_name(room) %>
    </h1>
</span>
  <a class="btn" style="view-transition-name: edit-room-<%= room.id %>" data-room-id="<%= room.id %>" href="/rooms/<%= room.type_route %>/<%= room.id %>/edit">
    <img aria-hidden="true" src="<%= asset_path "menu-dots-horizontal.svg" %>" width="20" height="20" />
    <span class="for-screen-reader">Settings for this <%= room.direct? ? "Ping" : "room" %></span>
</a>
  <%== render_bell(room) %>
