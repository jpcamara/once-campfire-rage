<div class="panel txt-align-center">
  <section class="directs--edit margin-block-end">
<% members.each do |member| %>
      <div class="member flex flex-column gap fill-shade pad border-radius">
        <figure class="avatar center" style="--avatar-border-radius: 10ch; --avatar-size: 10ch;" >
          <%== avatar_tag member, loading: "lazy" %>
        </figure>

        <strong><%= member.name %></strong>
      </div>
<% end %>
  </section>

  <form class="button_to" method="post" action="<%= base_url %>/rooms/directs/<%= room.id %>"><input type="hidden" name="_method" value="delete" /><button class="btn btn--negative center" aria-label="Delete Ping" data-turbo-confirm="Are you sure you want to delete this ping and all messages in it? This can’t be undone." type="submit">
    <img aria-hidden="true" src="<%= asset_path "trash.svg" %>" />
    Ping
</button></form>
</div>
