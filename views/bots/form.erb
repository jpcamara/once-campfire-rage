<section class="panel"<% if bot %> style="view-transition-name: chat-bot-<%= bot.id %>"<% end %>>
  <form class="flex flex-column gap" enctype="multipart/form-data" action="<%= bot ? "/account/bots/#{bot.id}" : "/account/bots" %>" accept-charset="UTF-8" method="post"><% if bot %><input type="hidden" name="_method" value="patch" /><% end %>
<h1 class="for-screen-reader">Chat Bot Setup</h1>
<label class="align-center center avatar__form gap" data-controller="upload-preview">
  <div class="btn input--file">
    <img aria-hidden="true" src="<%= asset_path "camera.svg" %>" width="20" height="20" />
    <input class="input" accept="image/*" data-upload-preview-target="input" data-action="upload-preview#previewImage" type="file" name="user[avatar]" id="user_avatar" />
    <span class="for-screen-reader">Upload bot avatar</span>
  </div>

  <div class="avatar input--file txt-xx-large" style="--avatar-size: var(--btn-size);">
    <img alt="Bot avatar" data-upload-preview-target="image" src="<%= bot_avatar_src %>" width="48" height="48" />
  </div>
</label>

<div class="flex align-center gap">
  <%== translation_button(:bot_name) %>
  <label class="flex align-center gap flex-item-grow txt-large input input--actor">
    <input class="input" autocomplete="name" placeholder="Name the bot" autofocus="autofocus" required="required" data-1p-ignore="true" type="text"<% if bot %> value="<%= bot.name %>"<% end %> name="user[name]" id="user_name" />
    <img aria-hidden="true" class="colorize--black" src="<%= asset_path "bot.svg" %>" width="24" height="24" />
  </label>
</div>

<div class="flex align-center gap">
  <%== translation_button(:webhook_url) %>
  <label class="flex align-center gap flex-item-grow txt-large input input--actor">
    <input class="input" placeholder="Webhook URL" type="url"<% if webhook_url %> value="<%= webhook_url %>"<% end %> name="user[webhook_url]" id="user_webhook_url" />
    <img aria-hidden="true" class="colorize--black" src="<%= asset_path "web.svg" %>" width="24" height="24" />
  </label>
</div>

<button class="btn btn--reversed center txt-large" type="submit"><img aria-hidden="true" src="<%= asset_path "check.svg" %>" width="20" height="20" /><span class="for-screen-reader">Save changes</span></button>
</form>
<% if bot %>
  <hr class="separator full-width margin-block-double">

  <div class="flex align-center gap justify-space-between">
    <form class="button_to" method="post" action="/account/bots/<%= bot.id %>"><input type="hidden" name="_method" value="delete" /><button class="btn txt--small btn--negative" aria-label="Delete this chat bot" data-turbo-confirm="Are you sure you want to permanently remove this bot from the account? This can’t be undone." type="submit">
      <img aria-hidden="true" src="<%= asset_path "trash.svg" %>" width="20" height="20" />
      <img aria-hidden="true" src="<%= asset_path "bot.svg" %>" width="20" height="20" />
</button></form>
    <form class="button_to" method="post" action="/account/bots/<%= bot.id %>/key"><input type="hidden" name="_method" value="put" /><button class="btn full-width txt--small btn--negative" aria-label="Generate a new key" data-turbo-confirm="Are you sure you want to change the bot key? All usage of this bot must be updated." type="submit">
      <img aria-hidden="true" src="<%= asset_path "refresh.svg" %>" width="20" height="20" />
      <img aria-hidden="true" src="<%= asset_path "key.svg" %>" width="20" height="20" />
</button></form>  </div>
<% end %>
</section>
