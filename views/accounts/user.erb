<li class="flex align-center gap margin-none <%= "banned" if member.status == 2 %>">
  <figure class="avatar flex-item-no-shrink" style="--avatar-size: 3.75ch;">
    <%== avatar_tag member, loading: "lazy" %>
  </figure>

  <div class="min-width">
    <div class="overflow-ellipsis fill-shade"><strong><%= member.name %></strong></div>
  </div>

  <hr class="separator" aria-hidden="true">
<% if current_user.can_administer? && member.active? %>
<% unless member.bot? %>
      <form data-controller="form" action="/account/users/<%= member.id %>" accept-charset="UTF-8" method="post"><input type="hidden" name="_method" value="patch" />
        <label class="btn txt-small flex-item-no-shrink" for="role_user_<%= member.id %>">
          <span class="for-screen-reader">Role: <%= member.administrator? ? "Administrator" : "Member" %></span>
          <img aria-hidden="true" src="<%= asset_path "crown.svg" %>" width="20" height="20" />
          <input name="user[role]"<% if member.id == current_user.id %> disabled="disabled"<% end %> type="hidden" value="member" /><input data-action="form#submit" hidden="hidden" id="role_user_<%= member.id %>"<% if member.id == current_user.id %> disabled="disabled"<% end %> type="checkbox" value="administrator"<% if member.administrator? %> checked="checked"<% end %> name="user[role]" />
        </label>
</form>
<% end %>
<% unless member.id == current_user.id %>
      <form class="button_to" method="post" action="/account/users/<%= member.id %>"><input type="hidden" name="_method" value="delete" /><button class="btn txt-small flex-item-no-shrink btn--negative" data-turbo-confirm="Are you sure you want to permanently remove this person from the account? This can’t be undone." type="submit">
        <img aria-hidden="true" src="<%= asset_path "minus.svg" %>" width="20" height="20" />
        <span class="for-screen-reader">Delete <%= member.name %></span>
</button></form>
<% end %>
<% end %>
<% if member.id == current_user.id %>
    <a class="btn txt-small flex-item-no-shrink" target="_top" href="/users/me/profile">
      <img aria-hidden="true" src="<%= asset_path "pencil.svg" %>" width="20" height="20" />
      <span class="for-screen-reader">My settings</span>
</a>
<% end %>
</li>
