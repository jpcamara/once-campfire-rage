<% unless (platform.safari? || platform.chrome?) && platform.ios? %>
  <details class="notifications-help" data-notifications-target="details">
    <summary class="btn">
      <img aria-hidden="true" src="<%= asset_path "external/web.svg" %>" width="20" height="20" />
      <strong>Check your <%= capitalize(platform.browser) %> settings</strong>
      <img aria-hidden="true" class="disclosure" src="<%= asset_path "disclosure.svg" %>" width="10" height="10" />
    </summary>
<% if platform.firefox? && platform.android? %>
        <ol>
          <li>Tap <em><img alt="the View site information button" src="<%= asset_path "lock.svg" %>" width="20" height="20" /></em> in the address bar.</li>
          <li>Tap <em>Notification</em> to change to <em>Allowed</em>.</li>
        </ol>
<% elsif platform.edge? && platform.desktop? %>
        <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for this website.</h2>
        <ol>
          <li>Click <em><img alt="the View site information button" src="<%= asset_path "lock.svg" %>" width="20" height="20" /></em> left of the address bar.</li>
          <li>Under <em>Permissions for this site &gt; Notifications</em>, choose <em>Allow</em>.</li>
        </ol>
        <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for <%= capitalize(platform.browser) %>.</h2>
        <ol>
<% if platform.windows? %>
            <li>Click <em>Start</em>, then <em>Settings</em>.</li>
            <li>Go to <em>System &gt; Notification</em>.</li>
            <li>Click <em><img alt="the switch" src="<%= asset_path "external/switch.svg" %>" width="22" height="22" /></em> <em>ON</em> for <%= capitalize(platform.browser) %>.</li>
<% else %>
            <li>Click <em aria-label="the Apple menu"></em> in the top left.</li>
            <li>Click <em>System Settings…</em>.</li>
            <li>Click <em>Notifications</em>.</li>
            <li>Click <em><%= capitalize(platform.browser) %></em>.</li>
            <li>Click <em><img alt="the switch" src="<%= asset_path "external/switch.svg" %>" width="22" height="22" /></em> to <em>Allow notifications</em>.</li>
<% end %>
        </ol>
<% elsif platform.firefox? && platform.desktop? %>
        <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for this website.</h2>
        <ol>
          <li>Click <em><%= capitalize(platform.browser) %></em> in the top left.</li>
          <li>Click <em>Settings…</em>.</li>
          <li>Click <em>Privacy & Security</em> in the sidebar.</li>
          <li>Scroll down to <em>Permissions</em>.</li>
          <li>Click <em>Settings</em> next to <em>Notifications</em>.</li>
          <li>Select <em>Allow</em> next to <em><%= base_url %>/</em>.</li>
        </ol>

        <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for <%= capitalize(platform.browser) %>.</h2>
        <ol>
<% if platform.windows? %>
            <li>Click <em>Start</em>, then <em>Settings</em>.</li>
            <li>Go to <em>System &gt; Notification</em>.</li>
            <li>Click <em><img alt="the toggle button" src="<%= asset_path "external/switch.svg" %>" width="22" height="22" /></em> <em>ON</em> for <%= capitalize(platform.browser) %>.</li>
<% else %>
            <li>Click <em aria-label="the Apple menu"></em> in the top left.</li>
            <li>Click <em>System Settings…</em>.</li>
            <li>Click <em>Notifications</em>.</li>
            <li>Click <em><%= capitalize(platform.browser) %></em>.</li>
            <li>Click <em><img alt="the switch" src="<%= asset_path "external/switch.svg" %>" width="22" height="22" /></em> to <em>Allow notifications</em>.</li>
<% end %>
        </ol>
<% elsif platform.chrome? && platform.desktop? %>
        <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for this website.</h2>
        <ol>
          <li>Click the <em><img alt="View site information" src="<%= asset_path "external/sliders.svg" %>" width="20" height="20" /></em> icon in the address bar.</li>
          <li>Click <em>Site Settings</em>.</li>
          <li>Ensure notifications are <em>Allowed</em>.</li>
        </ol>

        <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for <%= capitalize(platform.browser) %>.</h2>
        <ol>
<% if platform.windows? %>
            <li>Click <em>Start</em>, then <em>Settings</em>.</li>
            <li>Go to <em>System &gt; Notification</em>.</li>
            <li>Click <em><img alt="the switch" src="<%= asset_path "external/switch.svg" %>" width="22" height="22" /></em> <em>ON</em> for <%= capitalize(platform.browser) %>.</li>
<% else %>
            <li>Click <em aria-label="the Apple menu"></em> in the top left.</li>
            <li>Click <em>System Settings…</em>.</li>
            <li>Click <em>Notifications</em>.</li>
            <li>Click <em><%= capitalize(platform.browser) %></em>.</li>
            <li>Click <em><img alt="the switch" src="<%= asset_path "external/switch.svg" %>" width="22" height="22" /></em> to <em>Allow notifications</em>.</li>
<% end %>
        </ol>
<% elsif platform.chrome? && platform.android? %>
        <ol>
          <li>Tap the <em><img alt="More options" src="<%= asset_path "menu-dots-vertical.svg" %>" width="16" height="16" /></em> menu button.</li>
          <li>Tap <em>Settings</em>.</li>
          <li>Tap <em>Notifications</em>.</li>
          <li>Tap <em><img alt="the switch" src="<%= asset_path "external/switch.svg" %>" width="22" height="22" /></em> to <em>Allow <%= capitalize(platform.browser) %> notifications</em>.</li>
          <li>Tap <em><img alt="the switch" src="<%= asset_path "external/switch.svg" %>" width="22" height="22" /></em> next to <em>Web apps</em>.</li>
          <li>Tap <em><img alt="the notification bell" src="<%= asset_path "notification-bell-alert.svg" %>" width="16" height="16" /></em> and select <em>Allow</em>.</li>
        </ol>
<% elsif platform.safari? && platform.desktop? %>
        <ol>
          <li>Click <em><%= capitalize(platform.browser) %></em> in the top left.</li>
          <li>Click <em>Settings…</em>.</li>
          <li>Click the <em>Websites</em> tab.</li>
          <li>Click <em>Notifications</em> in the sidebar.</li>
          <li>Click <em><%= base_url %>/</em> in the list.</li>
          <li>Select <em>Allow</em>.</li>
        </ol>
<% else %>
        <p>Ensure notifications are enabled for <em><%= base_url %>/</em> in your web browser settings.</p>
<% end %>
  </details>
<% end %>
