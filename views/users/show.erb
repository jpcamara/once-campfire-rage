<section class="panel txt-align-center">
  <div class="flex flex-column gap <%= "banned" if user.status == 2 %>">
    <div class="avatar txt-xx-large center" style="background: white">
      <img alt="Profile avatar" class="avatar" src="<%= avatar_path(user) %>" />
    </div>
<% if user.bot? %>
      <div class="pad-double--inline push--inline push--block-start">
<% if user.active? %>
          <form class="button_to" method="post" action="/rooms/directs?user_ids%5B%5D=<%= user.id %>"><button class="btn btn--primary full-width txt--large" type="submit"><img src="<%= asset_path "messages.svg" %>" /></button></form>
<% else %>
          <div><%= user.name %> is no longer on this account</div>
<% end %>
      </div>
<% elsif user.status != 1 %>
        <div class="flex flex-column gap" style="--row-gap: calc(var(--block-space) / 3)">
          <h1 class="txt-x-large txt-tight-lines margin-none"><%= user.name %></h1>
<% if current_user.can_administer? %>
            <div><a href="mailto:<%= user.email_address %>"><%= user.email_address %></a></div>
<% end %>
          <div><%= user.bio %></div>
        </div>
<% if user.active? %>
          <div class="pad-inline-double margin-inline margin-block-start">
            <form class="button_to" method="post" action="/rooms/directs?user_ids%5B%5D=<%= user.id %>"><button class="btn btn--reversed full-width txt-large" type="submit">
              <img aria-hidden="true" aria-label="Ping <%= user.name %>" src="<%= asset_path "messages.svg" %>" />
</button></form>          </div>
<% if current_user.can_administer? %>
            <hr class="margin-block-start borderless">

            <%== render_transfer(user) %>
<% end %>
<% end %>
<% if current_user.can_administer? && current_user.id != user.id %>
          <div class="margin-block-start">
<% if user.active? %>
  <form class="button_to" method="post" action="/users/<%= user.id %>/ban"><button class="btn full-width" data-turbo-confirm="Are you sure you want to ban this user? This will log them out, delete their messages, and block their IP addresses." type="submit">
    <img aria-hidden="true" aria-label="Ban <%= user.name %>" src="<%= asset_path "cancel.svg" %>" />
    <span>Ban <%= user.name %></span>
</button></form>
<% else %>
  <form class="button_to" method="post" action="/users/<%= user.id %>/ban"><input type="hidden" name="_method" value="delete" /><button class="btn btn--negative full-width" data-turbo-confirm="Are you sure you want to remove the ban on this user?" type="submit">
    <img aria-hidden="true" aria-label="Remove Ban <%= user.name %>" src="<%= asset_path "cancel.svg" %>" />
    <span>Remove ban</span>
</button></form>
<% end %>
          </div>
<% end %>
<% else %>
        <div>
          <h1 class="txt-x-large margin-none"><%= user.name %></h1>
          <div><%= user.name %> is no longer on this account</div>
        </div>
<% end %>
  </div>
</section>
