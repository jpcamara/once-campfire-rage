  <a class="direct<%= " unread" if membership.unread? %>" id="list_<%= room.param_key %>_<%= room.id %>" data-rooms-list-target="room" data-room-id="<%= room.id %>" data-badge-dot-target="unread" data-sorted-list-target="item" data-sorted-list-number="<%= TimeFormat.epoch_ms(room.updated_at) %>" href="/rooms/<%= room.id %>">
<% if members.size > 1 %>
      <div class="avatar__group">
<% members.first(4).each do |member| %>
          <span class="avatar">
            <img aria-hidden="true" src="<%= avatar_path(member) %>" width="20" height="20" />
          </span>
<% end %>
      </div>
<% else %>
      <span class="avatar">
        <img aria-hidden="true" src="<%= avatar_path(members.first) %>" width="48" height="48" />
      </span>
<% end %>

    <span class="direct__author flex align-center gap max-width min-width border-radius txt-small">
      <span class="txt-nowrap overflow-ellipsis">
        <span class="for-screen-reader">Ping with</span>
<% if members.size > 1 %>
          <%= to_sentence(members.map { |member| member.name.split(" ")[0, 3].map { it[0].capitalize }.join }, two_words_connector: "+") %>
<% else %>
          <%= members.first.name.split(" ")[0] %>
<% end %>
      </span>
    </span>
</a>
